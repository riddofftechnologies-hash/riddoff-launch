rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Role helpers ───────────────────────────────────────────────────────
    // Reads the user's role from their profile doc — one get() per rule eval.

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isInstructor() {
      return isSignedIn() && (userRole() == 'instructor' || userRole() == 'admin');
    }

    function isEnrolledIn(cohortId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(uid() + '_' + cohortId));
    }

    // ─── Catalog (public read) ───────────────────────────────────────────────

    match /bootcamps/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // Lessons are a subcollection of courses
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /instructors/{id} {
      allow read: if true;
      allow write: if isInstructor();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_stats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      // Published FAQs are public; unpublished are admin-only
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Reviews ─────────────────────────────────────────────────────────────
    // userId field required — prevents anonymous reviews.

    match /reviews/{id} {
      allow read: if true;
      // Only enrolled students can create; they cannot edit after submission
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && isEnrolledIn(request.resource.data.cohortId);
      allow update, delete: if isAdmin();
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users read/write their own profile; admins read all
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Cohorts ──────────────────────────────────────────────────────────────

    match /cohorts/{cohortId} {
      // Enrolling/upcoming cohorts are public so the sales page can display them
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Payments ─────────────────────────────────────────────────────────────
    // Payments should be created by a Cloud Function after Razorpay webhook,
    // not directly by the client. Direct client writes are blocked.

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      // No direct client writes — payments are created server-side only
      allow write: if isAdmin();
    }

    // ─── Enrollments ──────────────────────────────────────────────────────────
    // Ideally created by a Cloud Function on payment success.
    // Until the payment webhook is built, authenticated users can self-enroll
    // but only into their own doc and only on specific fields.

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.progress == 0;
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == uid()
                        // Students can only update lastAccessedAt
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['lastAccessedAt']));
      allow delete: if isAdmin();
    }

    // ─── Sessions ─────────────────────────────────────────────────────────────

    match /sessions/{sessionId} {
      // Enrolled students can read sessions for their cohort
      allow read: if isEnrolledIn(resource.data.cohortId) || isInstructor();
      allow write: if isInstructor();
    }

    // ─── Attendance ───────────────────────────────────────────────────────────
    // Attendance is instructor-marked only — students cannot self-report.

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isInstructor());
      allow write: if isInstructor();
    }

    // ─── Assignments ──────────────────────────────────────────────────────────

    match /assignments/{assignmentId} {
      allow read: if isEnrolledIn(resource.data.cohortId) || isInstructor();
      allow write: if isInstructor();
    }

    // ─── Submissions ──────────────────────────────────────────────────────────
    // Field-level rules: students write content; instructors write grades.

    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isInstructor());

      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    // Students cannot set grade fields on creation
                    && !('grade' in request.resource.data)
                    && !('gradedBy' in request.resource.data)
                    && !('gradedAt' in request.resource.data);

      allow update: if
        // Students can update their own answer fields only
        (isSignedIn()
          && resource.data.userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fileUrl', 'textAnswer', 'submittedAt']))
        ||
        // Instructors can update grading fields only
        (isInstructor()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['grade', 'feedback', 'gradedBy', 'gradedAt']));

      allow delete: if isAdmin();
    }

    // ─── Residency scores ─────────────────────────────────────────────────────
    // Computed by Cloud Function — no client writes.

    match /residency_scores/{scoreId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isInstructor());
      allow write: if isAdmin();
    }

    match /residency_decisions/{decisionId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Certificates ─────────────────────────────────────────────────────────
    // Public read so anyone can verify a certificate URL.

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Lesson progress ──────────────────────────────────────────────────────

    match /lesson_progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isInstructor());
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && isEnrolledIn(request.resource.data.cohortId);
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isAdmin();
    }

    // ─── Skills ───────────────────────────────────────────────────────────────

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /student_skills/{studentSkillId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isInstructor());
      allow write: if isInstructor();
    }
  }
}
