rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public read for all course-related collections
    match /bootcamps/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /instructors/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /platform_stats/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
